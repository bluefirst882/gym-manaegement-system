.login-page {
  min-height: 100vh;
  background: linear-gradient(160deg, #ff6b6b, #ee5253 60%, #c0392b);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 160rpx;
}
.logo { font-size: 100rpx; }
.title { color: #fff; font-size: 48rpx; font-weight: 700; margin-top: 10rpx; }
.subtitle { color: rgba(255,255,255,0.85); font-size: 26rpx; margin-top: 8rpx; }
.form { width: 80%; margin-top: 80rpx; }
.input {
  background: #fff;
  border-radius: 44rpx;
  padding: 24rpx 36rpx;
  margin-bottom: 30rpx;
  font-size: 30rpx;
}
.login-btn { margin-top: 20rpx; background: #fff; color: #ee5253; font-weight: 700; }
.tip { color: rgba(255,255,255,0.7); font-size: 22rpx; margin-top: 40rpx; }
