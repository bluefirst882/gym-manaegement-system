.reg-card .top { display: flex; justify-content: space-between; align-items: center; }
.reg-card .no { font-size: 22rpx; color: #999; }
.reg-card .name { font-size: 30rpx; font-weight: 700; margin-top: 10rpx; }
.reg-card .meta { font-size: 24rpx; color: #666; margin-top: 8rpx; }
.reg-card .bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx dashed #eee; }
.reg-card .time { font-size: 22rpx; color: #999; }
.cancel-btn { background: #f5f5f5; color: #666; border-radius: 28rpx; }
