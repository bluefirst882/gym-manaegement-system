<view class="container">
  <view class="banner">{{venue.categoryName === '攀岩类' ? '🧗' : venue.categoryName === '滑板类' ? '🛹' : venue.categoryName === '蹦极类' ? '🪂' : '🏟️'}}</view>
 
  <view class="card">
    <view class="name">{{venue.venueName}}</view>
    <view class="row"><text class="label">分类</text><text>{{venue.categoryName}}</text></view>
    <view class="row"><text class="label">地址</text><text>{{venue.venueAddress}}</text></view>
    <view class="row"><text class="label">容量</text><text>{{venue.capacity}} 人</text></view>
    <view class="row"><text class="label">设施</text><text>{{venue.facilities}}</text></view>
    <view class="row"><text class="label">收费</text><text class="price">¥{{venue.feeAmount}}{{venue.feeType === 'ONCE' ? '/次' : '/小时'}}</text></view>
  </view>
 
  <view class="footer">
    <button class="btn-primary {{venue.status !== 'AVAILABLE' ? 'disabled' : ''}}" bindtap="goBooking">立即预约</button>
  </view>
</view>
