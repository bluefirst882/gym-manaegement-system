.venue-summary .name { font-size: 32rpx; font-weight: 700; }
.venue-summary .meta { font-size: 24rpx; color: #999; margin-top: 8rpx; }
 
.sec-title { font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx; }
.hint { font-size: 22rpx; color: #ee5253; font-weight: 400; }
 
.date-scroll { white-space: nowrap; }
.date-item {
  display: inline-block;
  width: 120rpx;
  text-align: center;
  padding: 16rpx 0;
  margin-right: 16rpx;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
}
.date-item.active { border-color: #ee5253; background: #fff0f0; }
.d-label { font-size: 26rpx; font-weight: 600; }
.d-sub { font-size: 20rpx; color: #999; margin-top: 4rpx; }
.date-item.active .d-sub { color: #ee5253; }
 
.time-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.time-item {
  width: 21%;
  text-align: center;
  padding: 14rpx 0;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
  font-size: 24rpx;
}
.time-item.active { border-color: #ee5253; background: #ee5253; color: #fff; }
.time-item.disabled { background: #f5f5f5; color: #ccc; }
 
.remark {
  width: 100%;
  min-height: 120rpx;
  background: #f7f8fa;
  border-radius: 10rpx;
  padding: 16rpx;
  font-size: 26rpx;
}
 
.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
}
