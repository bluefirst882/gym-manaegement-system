.banner {
  height: 300rpx;
  background: linear-gradient(135deg, #4b6cb7, #182848);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 130rpx;
}
.card { margin-top: 0; }
.container .card:first-of-type { margin-top: -30rpx; position: relative; }
.title { font-size: 34rpx; font-weight: 700; margin-bottom: 14rpx; }
.row { display: flex; padding: 12rpx 0; border-bottom: 1rpx dashed #eee; font-size: 26rpx; }
.row:last-child { border-bottom: none; }
.label { color: #999; width: 150rpx; flex-shrink: 0; }
.sec-title { font-size: 28rpx; font-weight: 700; margin-bottom: 14rpx; }
.text { font-size: 26rpx; color: #555; line-height: 1.7; }
.form-row { display: flex; align-items: center; margin-bottom: 16rpx; }
.picker { color: #333; border: 1rpx solid #eee; border-radius: 8rpx; padding: 10rpx 20rpx; }
.remark { width: 100%; min-height: 100rpx; background: #f7f8fa; border-radius: 10rpx; padding: 16rpx; font-size: 26rpx; }
.footer { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx; background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06); }
