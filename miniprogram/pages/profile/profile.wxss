.header {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #ff6b6b, #ee5253);
  padding: 60rpx 30rpx;
  gap: 24rpx;
}
.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.25);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
}
.info .name { color: #fff; font-size: 36rpx; font-weight: 700; }
.info .phone { color: rgba(255,255,255,0.85); font-size: 24rpx; margin-top: 8rpx; }
 
.menu { background: #fff; margin: 20rpx; border-radius: 16rpx; overflow: hidden; }
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f3f3f3;
  font-size: 28rpx;
}
.menu-item:last-child { border-bottom: none; }
.arrow { color: #ccc; font-size: 32rpx; }
 
.logout {
  margin: 30rpx 20rpx;
  background: #fff;
  color: #ee5253;
  border-radius: 44rpx;
  font-size: 30rpx;
}
